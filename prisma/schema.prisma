generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model user {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  
  // Champs Dumuni
  badge         String?      @default("Débutant") // Cordon Bleu, Spécialiste Tô...

  account       account[]
  session       session[]
  
  // Relations Dumuni
  recipes       Recipe[]     // Recettes créées par l'utilisateur
  books         RecipeBook[] // Dossiers/Carnets de recettes
  favorites     Favorite[]   // Favoris
  comments      Comment[]    // Questions et réponses posées
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

// ==========================================
// MODÈLES DÉDIÉS À DUMUNI 🍲
// ==========================================

model Recipe {
  id          String   @id @default(cuid())
  title       String
  description String?
  prepTime    Int?     // en minutes
  cookTime    Int?     // en minutes
  servings    Int?     // nombre de personnes
  imageUrl    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId    String
  author      user     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  steps       Step[]
  ingredients RecipeIngredient[]
  favorites   Favorite[]
  comments    Comment[]
}

model Step {
  id           String   @id @default(cuid())
  order        Int      // L'ordre (1, 2, 3...)
  instruction  String
  timerMinutes Int?     // Minuteur optionnel (ex: 25 pour "Démarrer 25 min")
  
  recipeId     String
  recipe       Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Ingredient {
  id      String @id @default(cuid())
  name    String @unique // ex: "Riz", "Gombo", "Viande de boeuf"
  
  recipes RecipeIngredient[]
}

model RecipeIngredient {
  id           String @id @default(cuid())
  quantity     String // ex: "500g", "2 c.à.s.", "1 kg"
  
  recipeId     String
  recipe       Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
}

// ------ SOCIAL & ENGAGEMENT ------

model RecipeBook {
  id        String   @id @default(cuid())
  name      String   // ex: "Pour dimanche", "Soir de semaine"
  createdAt DateTime @default(now())

  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  favorites Favorite[] // Les recettes mises dans ce carnet
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId       String
  user         user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recipeId     String
  recipe       Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  
  recipeBookId String?
  recipeBook   RecipeBook? @relation(fields: [recipeBookId], references: [id], onDelete: SetNull)

  @@unique([userId, recipeId]) // Un user ne peut mettre en favori qu'une fois une recette
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  // Pour gérer les fils de réponses (FAQ / Questions)
  parentId  String?
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentToComment")
}
